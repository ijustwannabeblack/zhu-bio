{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhu-bio",
  "main": "worker.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "assets": {
    "directory": "."
  },
  "routes": [
    {
      "pattern": "larpifyy.asia",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "larpifyy-db",
      "database_id": "e184eac8-4e11-49f2-899d-91daaa7971ff"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "438655b8873a42bdbc6cabed0fafe934"
    }
  ]
}
