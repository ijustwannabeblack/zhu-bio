{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhu-bio",
  "main": "worker.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "."
  },
  "routes": [
    {
      "pattern": "larpifyy.asia",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "438655b8873a42bdbc6cabed0fafe934"
    }
  ]
}
